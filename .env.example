# Copy to .env for local development. Docker Compose sets these values itself.

# PostgreSQL connection string. Required.
DATABASE_URL=postgresql://card:card@localhost:5432/digital_card?schema=public

# HTTP port. Optional, defaults to 3000.
PORT=3000

# Allowed CORS origins (comma-separated). Optional.
# If not set, all origins are allowed (suitable for a public read-only API).
# Example: CORS_ORIGIN=https://mysite.com,https://staging.mysite.com
# CORS_ORIGIN=
