// Database schema of the digital business card.
// The API serves a single profile, so every other table hangs off `Profile`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id           Int      @id @default(autoincrement())
  // Stable identifier used by the seed to find and update the row.
  slug         String   @unique
  name         String
  title        String
  description  String   @db.Text
  location     String?
  availability String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  links       ProfileLink[]
  skills      Skill[]
  experiences Experience[]
  projects    Project[]
  educations  Education[]
}

enum LinkKind {
  GITHUB
  TELEGRAM
  EMAIL
  WEBSITE
  OTHER
}

model ProfileLink {
  id        Int      @id @default(autoincrement())
  profileId Int
  kind      LinkKind
  label     String
  url       String
  sortOrder Int      @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

enum SkillCategory {
  LANGUAGES_AND_FRAMEWORKS
  API_AND_ARCHITECTURE
  DATABASES_AND_QUEUES
  DEVOPS_AND_INFRASTRUCTURE
  TESTING
}

model Skill {
  id        Int           @id @default(autoincrement())
  profileId Int
  name      String
  category  SkillCategory
  sortOrder Int           @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
}

model Experience {
  id          Int       @id @default(autoincrement())
  profileId   Int
  company     String
  position    String
  description String?   @db.Text
  // Only year and month matter for the card, so dates are stored as the first day of the month.
  startDate   DateTime  @db.Date
  // `null` means the job is still ongoing.
  endDate     DateTime? @db.Date

  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  achievements Achievement[]

  @@index([profileId])
}

model Achievement {
  id           Int    @id @default(autoincrement())
  experienceId Int
  text         String @db.Text
  sortOrder    Int    @default(0)

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

model Project {
  id           Int      @id @default(autoincrement())
  profileId    Int
  name         String
  description  String   @db.Text
  url          String?
  technologies String[]
  sortOrder    Int      @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Education {
  id             Int     @id @default(autoincrement())
  profileId      Int
  institution    String
  degree         String
  specialty      String?
  graduationYear Int
  sortOrder      Int     @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
